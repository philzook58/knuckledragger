(declare-sort ZFSet 0)
(declare-fun |∈| (ZFSet ZFSet) Bool)
(declare-fun bigunion (ZFSet) ZFSet)
(declare-fun sep (ZFSet (Array ZFSet Bool)) ZFSet)
(declare-fun is_ordinal (ZFSet) Bool)
(declare-fun C!2327 () ZFSet)
(declare-fun zf.succ (ZFSet) ZFSet)
(declare-fun ZFSet.le (ZFSet ZFSet) Bool)
(assert (forall ((x ZFSet))
  (let ((a!1 (bigunion (sep C!2327 (lambda ((x!1 ZFSet)) (is_ordinal x!1))))))
    (or (not (|∈| x (zf.succ a!1))) (|∈| x a!1)))))
(assert (let ((a!1 (bigunion (sep C!2327 (lambda ((x ZFSet)) (is_ordinal x))))))
  (|∈| a!1 (zf.succ a!1))))
(assert (forall ((A ZFSet)) (or (not (is_ordinal A)) (|∈| A C!2327))))
(assert (forall ((x ZFSet))
  (let ((a!1 (|∈| x (sep C!2327 (lambda ((x!1 ZFSet)) (is_ordinal x!1))))))
    (or (is_ordinal x) (not a!1)))))
(assert (let ((a!1 (bigunion (sep C!2327 (lambda ((x ZFSet)) (is_ordinal x))))))
  (is_ordinal a!1)))
(assert (let ((a!1 (bigunion (sep C!2327 (lambda ((x ZFSet)) (is_ordinal x))))))
  (is_ordinal (zf.succ a!1))))
(assert (let ((a!1 (bigunion (sep C!2327 (lambda ((x ZFSet)) (is_ordinal x))))))
  (|∈| (zf.succ a!1) (sep C!2327 (lambda ((x ZFSet)) (is_ordinal x))))))
(assert (let ((a!1 (bigunion (sep C!2327 (lambda ((x ZFSet)) (is_ordinal x))))))
  (ZFSet.le (zf.succ a!1) a!1)))
(assert (let ((a!1 (bigunion (sep C!2327 (lambda ((x ZFSet)) (is_ordinal x))))))
  (not (|∈| a!1 a!1))))
